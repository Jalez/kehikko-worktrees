{
  "name": "kehikko-worktrees",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Worktrees, a module a Kehikot host frames: every git worktree of your projects, what each takes on the disk and where its pull request stands, cleaned up once its work is merged, and agents kept working in worktrees.",
  "scripts": {
    "dev": "vite",
    "build": "bun run build.ts",
    "start": "bun run serve.ts",
    "register": "bun run register.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:door": "kehikot-check-door",
    "check:parts": "kehikot-check-parts",
    "check:rows": "kehikot-check-rows"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kehikot-module-protocol": "git+https://github.com/Jalez/kehikko-protocol.git#v2.82.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.2.4"
  }
}
